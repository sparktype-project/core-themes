{
  "name": "Sparkdocs",
  "version": "2.0.0",
  "files": [
    { "path": "theme.json", "type": "manifest" },
    { "path": "base.hbs", "type": "base" },
    { "path": "font-faces.css", "type": "stylesheet" },
    { "path": "styles.css", "type": "stylesheet" },
    { "path": "partials/head.hbs", "type": "partial", "name": "head" },
    { "path": "partials/header.hbs", "type": "partial", "name": "header" },
    { "path": "partials/sidebar.hbs", "type": "partial", "name": "sidebar" },
    { "path": "partials/footer.hbs", "type": "partial", "name": "footer" }
  ],
  "stylesheets": [
    { "path": "font-faces.css", "type": "addon" },
    { "path": "styles.css", "type": "main" }
  ],
  "layouts": ["page", "blog-post", "hero-page", "list-view"],
  "appearanceSchema": {
    "description": "Customise the colors, fonts and layout of your site.",
    "type": "object",
    "properties": {
      "--color-background": {
        "type": "string",
        "title": "Page background",
        "format": "color",
        "default": "#ffffff"
      },
      "--color-text": {
        "type": "string",
        "title": "Body text",
        "format": "color",
        "default": "#1f2937"
      },
      "--color-heading": {
        "type": "string",
        "title": "Headings",
        "format": "color",
        "default": "#111827"
      },
      "--color-primary": {
        "type": "string",
        "title": "Primary accent",
        "format": "color",
        "default": "#3b82f6"
      },
      "--color-border": {
        "type": "string",
        "title": "Borders",
        "format": "color",
        "default": "#e5e7eb"
      },
      "--color-sidebar": {
        "type": "string",
        "title": "Sidebar background",
        "format": "color",
        "default": "#ffffff"
      },
      "--font-display": {
        "type": "string",
        "title": "Headings style",
        "description": "Choose the font family for all headlines.",
        "enum": [
          "var(--font-family-system-sans)",
          "var(--font-family-system-serif)",
          "var(--font-family-inter)",
          "var(--font-family-geist)",
          "var(--font-family-geist-mono)",
          "var(--font-family-special-gothic)",
          "var(--font-family-ibm-plex-sans)",
          "var(--font-family-ibm-plex-serif)",
          "var(--font-family-ibm-plex-mono)",
          "var(--font-family-instrument-serif)",
          "var(--font-family-instrument-sans)",
          "var(--font-family-gentium-book-plus)",
          "var(--font-family-playfair-display)"
        ],
        "enumNames": [
          "System sans",
          "System serif",
          "Inter",
          "Geist",
          "Geist Mono",
          "Special Gothic",
          "IBM Plex Sans",
          "IBM Plex Serif",
          "IBM Plex Mono",
          "Instrument Serif",
          "Instrument Sans",
          "Gentium Book Plus",
          "Playfair Display"
        ],
        "default": "var(--font-family-inter)"
      },

      "--font-body": {
        "type": "string",
        "title": "Body text style",
        "description": "Choose the font family for all paragraphs and lists.",
        "enum": [
          "var(--font-family-system-sans)",
          "var(--font-family-system-serif)",
          "var(--font-family-inter)",
          "var(--font-family-geist)",
          "var(--font-family-geist-mono)",
          "var(--font-family-special-gothic)",
          "var(--font-family-ibm-plex-sans)",
          "var(--font-family-ibm-plex-serif)",
          "var(--font-family-ibm-plex-mono)",
          "var(--font-family-instrument-serif)",
          "var(--font-family-instrument-sans)",
          "var(--font-family-gentium-book-plus)",
          "var(--font-family-playfair-display)"
        ],
        "enumNames": [
          "System sans",
          "System serif",
          "Inter",
          "Geist",
          "Geist Mono",
          "Special Gothic",
          "IBM Plex Sans",
          "IBM Plex Serif",
          "IBM Plex Mono",
          "Instrument Serif",
          "Instrument Sans",
          "Gentium Book Plus",
          "Playfair Display"
        ],
        "default": "var(--font-family-gentium-book-plus)"
      },
      "--sidebar-width": {
        "type": "string",
        "title": "Sidebar width",
        "description": "Choose the width of the navigation sidebar.",
        "enum": ["240px", "280px", "320px"],
        "enumNames": ["Narrow (240px)", "Medium (280px)", "Wide (320px)"],
        "default": "280px"
      }
    }
  },
  "themeDataSchema": {
    "type": "object",
    "properties": {
      "header_content": {
        "type": "string",
        "title": "Header content",
        "description": "Optional HTML content for the header area",
        "format": "textarea",
        "default": ""
      },
      "github_link": {
        "type": "string",
        "title": "Github link",
        "description": "Link to a Github repository.",
        "format": "textfield",
        "default": ""
      },
      "discord_link": {
        "type": "string",
        "title": "Discord link",
        "description": "Link to a Discord server.",
        "format": "textfield",
        "default": ""
      },
      "xtwitter_link": {
        "type": "string",
        "title": "X/Twitter link",
        "description": "Link to a X/Twitter profile.",
        "format": "textfield",
        "default": ""
      },
      "bluesky_link": {
        "type": "string",
        "title": "Bluesky link",
        "description": "Link to a Bluesky profile.",
        "format": "textfield",
        "default": ""
      },
       "web_link": {
        "type": "string",
        "title": "Web link",
        "description": "Link to a Web address.",
        "format": "textfield",
        "default": ""
      },
      "footer_content": {
        "type": "string",
        "title": "Footer content",
        "description": "Optional HTML content for the footer",
        "format": "textarea",
        "default": ""
      }
    }
  }
}
