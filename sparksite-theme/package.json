{
  "name": "sparksite-theme",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "copy": "node scripts/copy-to-sparktype.js",
    "build:copy": "npm run build && npm run copy",
    "build:and:copy": "npm run build:copy",
    "dev": "vite build --watch",
    "watch": "node scripts/watch-and-copy.js"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0-alpha.25",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "tailwindcss": "^4.0.0-alpha.25",
    "vite": "^5.4.11"
  }
}
